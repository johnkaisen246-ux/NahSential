local function InstantClickBlock()
    local executed = false
    if not cachedBlockBtn then CacheUI() end
    if cachedBlockBtn then
        if getconnections then
            for _, conn in ipairs(getconnections(cachedBlockBtn.Activated)) do conn:Fire(); executed = true end
            for _, conn in ipairs(getconnections(cachedBlockBtn.MouseButton1Click)) do conn:Fire(); executed = true end
        end
        if cachedBlockBtn:IsA("GuiButton") or cachedBlockBtn:IsA("ImageButton") then
            pcall(function() cachedBlockBtn:Activate(); executed = true end)
        end
    end
    if not executed and blockRemote then pcall(function() blockRemote:FireServer() end); executed = true end
    if not executed then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
    end
end

