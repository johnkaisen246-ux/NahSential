-- Backstab Target Resolver
local function GetClosestKillerHRP()
    local myChar = lp.Character
    if not myChar then return nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local closestHrp = nil
    local shortestDist = math.huge

    for _, killer in ipairs(KillersFolder:GetChildren()) do
        local kHrp = killer:FindFirstChild("HumanoidRootPart")
        if kHrp then
            local dist = (myHrp.Position - kHrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestHrp = kHrp
            end
        end
    end

    return closestHrp
end

-- Continuous Char + Camera Lock for Backstab
local function ContinuousBackstabLock(targetHrp, duration)
    local myChar = lp.Character
    if not myChar or not targetHrp then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local startTime = os.clock()
    local connection
    connection = RunService.PreRender:Connect(function()
        if os.clock() - startTime >= duration or not targetHrp.Parent or not myHrp.Parent then
            connection:Disconnect()
            return
        end

        local targetPos = Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z)
        myHrp.CFrame = CFrame.lookAt(myHrp.Position, targetPos)
        
        if workspace.CurrentCamera then
            workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, targetHrp.Position)
        end
    end)
end

-- Backstab Execution Logic
local function ExecuteBackstab()
    if not autoBackstabOn then return end

    local myChar = lp.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local kHrp = GetClosestKillerHRP()
    if not kHrp then return end

    local targetCFrame = kHrp.CFrame * CFrame.new(0, 0, backstabDistance)

    if backstabMode == "Teleport" then
        myHrp.CFrame = targetCFrame
    elseif backstabMode == "Lerp" then
        local tweenInfo = TweenInfo.new(lerpSpeed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local tween = TweenService:Create(myHrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
    end

    if backstabAimbotOn then
        task.spawn(ContinuousBackstabLock, kHrp, backstabAimDuration)
    end
end

