local function GetSpecificKillerDelay(charName)
    local name = charName:lower()
    if name:find("slasher") then return killerDelays.slasher
    elseif name:find("coolkidd") or name:find("c00lkidd") or name:find("1x") then return killerDelays.coolkidd
    elseif name:find("noli") then return killerDelays.noli
    elseif name:find("nosferatu") then return killerDelays.nosferatu
    elseif name:find("azure") then return killerDelays.azure
    end
    return 0
end

local function ExecuteBlockFast(kHrp, isPriorityTarget, charName)
    local specificDelay = GetSpecificKillerDelay(charName)
    local totalDelay = autoBlockDelay + specificDelay

    if totalDelay > 0 and not isPriorityTarget then
        task.wait(totalDelay)
    elseif specificDelay > 0 and isPriorityTarget then
        task.wait(specificDelay)
    end

    InstantClickBlock()

    if autoPunchOn then
        if autoPunchDelay > 0 and not isPriorityTarget then
            task.wait(autoPunchDelay)
        end
        if punchAimbotOn and kHrp then
            task.spawn(ContinuousLockTarget, kHrp, punchAimDuration)
        end
        InstantClickPunch()
    end
end

local function HighlightAttackHitbox(kHrp)
    if not attackHitboxVisualOn or not kHrp then return end
    
    local width = hbSize.left + hbSize.right
    local height = hbSize.upper + hbSize.under
    local depth = hbSize.front + hbSize.back

    local offsetZ = (hbSize.back - hbSize.front) / 2
    local offsetX = (hbSize.right - hbSize.left) / 2
    local offsetY = (hbSize.upper - hbSize.under) / 2

    local attackBox = Instance.new("Part")
    attackBox.Name = "AttackHitboxVisual"
    attackBox.Size = Vector3.new(width, height, depth) * hitboxMultiplier
    attackBox.CFrame = kHrp.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
    attackBox.Anchored = true
    attackBox.CanCollide = false
    attackBox.Material = Enum.Material.ForceField
    attackBox.Color = Color3.fromRGB(255, 30, 30)
    attackBox.Transparency = 0.3
    attackBox.Parent = workspace

    if hdtEnabled then
        local duration = hdtDuration
        local startTime = os.clock()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if os.clock() - startTime >= duration or not attackBox or not attackBox.Parent then
                conn:Disconnect()
                if attackBox then attackBox:Destroy() end
                return
            end
            local speedMultiplier = math.max(kHrp.AssemblyLinearVelocity.Magnitude / hdtBaseMinSpeed, 1)
            attackBox.Size = (Vector3.new(width, height, depth) * hitboxMultiplier) * Vector3.new(1, 1, speedMultiplier)
        end)
    else
        task.delay(0.2, function()
            if attackBox then attackBox:Destroy() end
        end)
    end
end

local function CleanAnimId(rawId)
    if not rawId then return "" end
    return tostring(rawId):match("%d+") or ""
end

local function CheckAndTrigger(character, rawAnimId)
    if not autoBlockOn then return end
    
    local cleanId = CleanAnimId(rawAnimId)
    local rawString = tostring(rawAnimId)
    
    local isPriorityTarget = FastPriorityAnims[cleanId] or FastPriorityAnims[rawString]

    if not isPriorityTarget and not TargetAnimationIDs[cleanId] and not TargetAnimationIDs[rawString] then 
        return 
    end

    local kHrp = character:FindFirstChild("HumanoidRootPart")
    local myChar = lp.Character
    if not myChar or not kHrp then return end
    
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local rawDist = (myHrp.Position - kHrp.Position).Magnitude

    if rawDist < antiBlockBaitRange then
        return
    end

    if facingCheckOn and rawDist <= facingCheckRange and not isPriorityTarget then
        local localPos = kHrp.CFrame:PointToObjectSpace(myHrp.Position)
        if localPos.Z > 0 or math.abs(localPos.X) > (facingCheckWidth / 2) then
            return
        end
    end

    local modeBonus = 0
    if autoBlockMode == "Aggressive" then modeBonus = 8
    elseif autoBlockMode == "Strict" then modeBonus = -2 end

    local baseRange = detectionRange + modeBonus
    if isPriorityTarget then baseRange = baseRange + 8 end
    if betterAutoBlockOn then baseRange = baseRange + 5 end

    local effectiveRange = (baseRange * hitboxMultiplier) * distanceMultiplier

    if rawDist <= effectiveRange then
        HighlightAttackHitbox(kHrp)
        task.spawn(ExecuteBlockFast, kHrp, isPriorityTarget, character.Name)
    end
end

local function TrackCharacter(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    local animator = humanoid and humanoid:WaitForChild("Animator", 5)

    if animator then
        animator.AnimationPlayed:Connect(function(track)
            local anim = track.Animation
            if anim then CheckAndTrigger(character, anim.AnimationId) end
        end)
        
        local processedTracks = {}
        local connection
        connection = RunService.Stepped:Connect(function()
            if not character or not character.Parent then
                connection:Disconnect()
                return
            end
            if autoBlockOn then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.IsPlaying and track.TimePosition < 0.5 then
                        local anim = track.Animation
                        if anim and not processedTracks[track] then
                            processedTracks[track] = true
                            CheckAndTrigger(character, anim.AnimationId)
                            task.delay(0.08, function() processedTracks[track] = nil end)
                        end
                    end
                end
            end
        end)
    end
end

