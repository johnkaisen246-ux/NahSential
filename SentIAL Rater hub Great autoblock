-- [[ DUAL SCANNER & RENDER ENGINE ]]
RunService.RenderStepped:Connect(function()
    local playersFolder = Workspace:FindFirstChild("Players")
    local killersFolder = playersFolder and playersFolder:FindFirstChild("Killers")
    if not killersFolder then return end

    for _, killer in ipairs(killersFolder:GetChildren()) do
        if killer:IsA("Model") then
            local hrp = killer:FindFirstChild("HumanoidRootPart")
            local humanoid = killer:FindFirstChildOfClass("Humanoid")
            local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

            -- Always update hitbox position so overlap checks work continuously
            if hrp then
                if not hitboxElements[killer] then
                    local boxPart = Instance.new("Part")
                    boxPart.Name = "CustomKillerHitbox"
                    boxPart.Material = Enum.Material.Neon
                    boxPart.Color = Color3.fromRGB(255, 30, 30)
                    boxPart.Transparency = config.hitboxVisualOn and 0.6 or 1
                    boxPart.CanCollide = false
              boxPart.Anchored = true
                    boxPart.CastShadow = false
                    boxPart.Parent = visualFolder

                    local selectionBox = Instance.new("SelectionBox")
                    selectionBox.Color3 = Color3.fromRGB(255, 0, 0)
                    selectionBox.LineThickness = 0.05
                    selectionBox.Adornee = boxPart
                    selectionBox.Visible = config.hitboxVisualOn
                    selectionBox.Parent = boxPart

                    hitboxElements[killer] = {Part = boxPart, Selection = selectionBox}
                else
                    local data = hitboxElements[killer]
                    local totalWidth = config.hitboxLeft + config.hitboxRight
                    local totalHeight = config.hitboxUpper + config.hitboxUnder
                    local totalLength = config.hitboxFront + config.hitboxBack

                    local offsetX = (config.hitboxRight - config.hitboxLeft) / 2
                    local offsetY = (config.hitboxUpper - config.hitboxUnder) / 2
                    local offsetZ = (config.hitboxBack - config.hitboxFront) / 2

                    data.Part.Transparency = config.hitboxVisualOn and 0.6 or 1
                    data.Selection.Visible = config.hitboxVisualOn
                    data.Part.Size = Vector3.new(totalWidth, totalHeight, totalLength)
                    data.Part.CFrame = hrp.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
                end
            end

            -- Ground Red Circle Render
            if config.circleVisualOn and hrp then
                if not visualElements[killer] then
                    local circle = Instance.new("Part")
                    circle.Name = "KillerRedCircle"
                    circle.Shape = Enum.PartType.Cylinder
                    circle.Material = Enum.Material.Neon
                    circle.Color = Color3.fromRGB(255, 30, 30)
                    circle.Transparency = 0.5
                    circle.Size = Vector3.new(0.2, config.detectionRadius * 2, config.detectionRadius * 2)
                    circle.CanCollide = false
                    circle.CanQuery = false
                    circle.CanTouch = false
                    circle.Anchored = true
                    circle.CastShadow = false
                    circle.Parent = visualFolder

                    visualElements[killer] = {Part = circle}
                else
                    local part = visualElements[killer].Part
                    part.Size = Vector3.new(0.2, config.detectionRadius * 2, config.detectionRadius * 2)

                    local ray = Ray.new(hrp.Position, Vector3.new(0, -15, 0))
                    local hit, hitPos = Workspace:FindPartOnRayWithIgnoreList(ray, {killer, visualFolder})
                    local groundPos = hitPos or (hrp.Position - Vector3.new(0, 3, 0))

                    part.CFrame = CFrame.new(groundPos) * CFrame.Angles(0, 0, math.rad(90))
                end
            end

            -- Overlap-Filtered Animation Detection Engine
            if config.autoBlockOn and animator and hrp then
                if isTouchingHitboxPart(killer) then
                    local tracks = animator:GetPlayingAnimationTracks()
                    for i = 1, #tracks do
                        local track = tracks[i]
                        local anim = track.Animation
                        local animId = anim and anim.AnimationId
                        
                        if animId then
                            local rawId = animId:match("%d+")
                            if rawId and killerM1AnimIds[rawId] then
                                local now = os.clock()
                                if not activeTrackDebounce[rawId] or (now - activeTrackDebounce[rawId]) > 0.3 then
                                    activeTrackDebounce[rawId] = now
                                    executeInstantBlock(killer)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- [[ SOUND DETECTOR BACKUP ]]
local function attachSoundHook(sound)
    if not sound:IsA("Sound") then return end
    sound.Played:Connect(function()
        if config.autoBlockSoundOn and attackSoundIds[sound.SoundId] then
            local killerModel = sound:FindFirstAncestorOfClass("Model")
            if killerModel and isTouchingHitboxPart(killerModel) then
                executeInstantBlock(killerModel)
            end
        end
    end)
end

for _, desc in ipairs(Workspace:GetDescendants()) do attachSoundHook(desc) end
Workspace.DescendantAdded:Connect(attachSoundHook)
