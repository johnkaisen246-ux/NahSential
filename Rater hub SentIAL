-- Cached UI Elements
local cachedBlockBtn = nil
local cachedPunchBtn = nil
local blockFires = {}

local function RefreshButtonCache()
    local pGui = lp:FindFirstChild("PlayerGui")
    if not pGui then return end
    local mainUI = pGui:FindFirstChild("MainUI")
    if not mainUI then return end
    local container = mainUI:FindFirstChild("AbilityContainer")
    if not container then return end
    
    cachedBlockBtn = container:FindFirstChild("Block")
    cachedPunchBtn = container:FindFirstChild("Punch")

    table.clear(blockFires)

    if cachedBlockBtn and getconnections then
        for _, conn in ipairs(getconnections(cachedBlockBtn.Activated)) do table.insert(blockFires, conn) end
        for _, conn in ipairs(getconnections(cachedBlockBtn.MouseButton1Click)) do table.insert(blockFires, conn) end
    end
end

RefreshButtonCache()
lp.CharacterAdded:Connect(function()
    task.defer(RefreshButtonCache)
end)

-- Direct GUI Trigger (Прямой клик по UI без InputManager / VirtualUser)
local function TriggerGuiButton(btn)
    if not btn then return end
    
    -- 1. Вызов зарегистрированных сокет-событий (firesignal)
    if firesignal then
        if btn:IsA("GuiButton") then
            pcall(function() firesignal(btn.Activated) end)
            pcall(function() firesignal(btn.MouseButton1Click) end)
            pcall(function() firesignal(btn.MouseButton1Down) end)
            pcall(function() firesignal(btn.MouseButton1Up) end)
        end
    end

    -- 2. Обход через getconnections для Mobile/Delta среды
    if getconnections then
        for _, name in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down", "TouchTap"}) do
            if btn[name] then
                for _, conn in ipairs(getconnections(btn[name])) do
                    pcall(function() conn:Fire() end)
                end
            end
        end
    end

    -- 3. Резервный вызов встроенного метода
    if btn:IsA("GuiButton") and btn.Activate then
        pcall(function() btn:Activate() end)
    end
end

local function InstantClickBlock()
    if #blockFires > 0 then
        for i = 1, #blockFires do blockFires[i]:Fire() end
    elseif cachedBlockBtn then
        TriggerGuiButton(cachedBlockBtn)
    else
        RefreshButtonCache()
    end
end

local function InstantClickPunch()
    local punchBtn = lp.PlayerGui:FindFirstChild("MainUI") 
        and lp.PlayerGui.MainUI:FindFirstChild("AbilityContainer") 
        and lp.PlayerGui.MainUI.AbilityContainer:FindFirstChild("Punch")
        
    if punchBtn then
        TriggerGuiButton(punchBtn)
    elseif cachedPunchBtn then
        TriggerGuiButton(cachedPunchBtn)
    else
        RefreshButtonCache()
    end
end

-- Aimbot Logic (Char + Camera Lock)
local function FaceTarget(targetHrp)
    local myChar = lp.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local camera = Workspace.CurrentCamera
    if not myHrp or not targetHrp then return end

    local targetPos = Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z)
    
    -- Поворот персонажа
    myHrp.CFrame = CFrame.lookAt(myHrp.Position, targetPos)

    -- Поворот и удержание камеры на цели (Char + Camera + Lock)
    if camera then
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHrp.Position)
        
        if aimPunchMode == "Char + Camera Lock" then
            local lockDuration = 0.5
            local startTime = tick()
            local conn
            conn = RunService.RenderStepped:Connect(function()
                if tick() - startTime > lockDuration or not targetHrp or not targetHrp.Parent then
                    conn:Disconnect()
                    return
                end
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetHrp.Position)
                myHrp.CFrame = CFrame.lookAt(myHrp.Position, targetPos)
            end)
        end
    end
end

local function ExecuteBlockFast(kHrp)
    InstantClickBlock()

    if autoPunchOn then
        if punchAimbotOn and kHrp then
            FaceTarget(kHrp)
        end
        InstantClickPunch()
    end
end

local function FastProcessTrack(track, character)
    local anim = track.Animation
    if anim and TargetAnimationIDs[anim.AnimationId] then
        local myChar = lp.Character
        local kHrp = character:FindFirstChild("HumanoidRootPart")
        if not myChar or not kHrp then return end
        
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        if not autoBlockOn then return end

        local rawDist = (myHrp.Position - kHrp.Position).Magnitude

        if facingCheckOn then
            local toPlayer = (myHrp.Position - kHrp.Position).Unit
            if kHrp.CFrame.LookVector:Dot(toPlayer) < 0.1 then
                return
            end
        end

        local modeBonus = (autoBlockMode == "Aggressive" and 8) or (autoBlockMode == "Strict" and -2) or 0
        local baseRange = detectionRange + modeBonus
        if betterAutoBlockOn then baseRange = baseRange + 5 end

        local effectiveRange = (baseRange * hitboxMultiplier) * distanceMultiplier

        if rawDist <= effectiveRange then
            ExecuteBlockFast(kHrp)
        end
    end
end

local function TrackCharacter(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    local animator = humanoid and humanoid:WaitForChild("Animator", 3)

    if animator then
        animator.AnimationPlayed:Connect(function(track)
            FastProcessTrack(track, character)
        end)
    end
end

-- Visual Rendering Functions
local function updateVisionShape(killer)
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if activeCones[killer] then
        activeCones[killer]:Destroy()
        activeCones[killer] = nil
    end

    if showVisionConeOn then
        local calcRadius = (detectionRange * hitboxMultiplier) * distanceMultiplier
        
        if visionShape == "Circle" then
            local cone = Instance.new("CylinderHandleAdornment")
            cone.Name = "VisionCone"
            cone.Adornee = hrp
            cone.AlwaysOnTop = true
            cone.Transparency = 0.5
            cone.Color3 = Color3.fromRGB(255, 0, 0)
            cone.Height = 0.1
            cone.Radius = calcRadius
            cone.CFrame = CFrame.new(0, -(hrp.Size.Y / 2), 0) * CFrame.Angles(math.rad(90), 0, 0)
            cone.Parent = hrp
            activeCones[killer] = cone
        else
            local shapePart = Instance.new("Part")
            shapePart.Name = "VisionShape"
            shapePart.Anchored = false
            shapePart.CanCollide = false
            shapePart.Material = Enum.Material.ForceField
            shapePart.Color = Color3.fromRGB(255, 0, 0)
            shapePart.Transparency = 0.5

            if visionShape == "Square" then
                shapePart.Size = Vector3.new(calcRadius * 2, 0.1, calcRadius * 2)
            elseif visionShape == "Rectangle" then
                shapePart.Size = Vector3.new(calcRadius * 1.5, 0.1, calcRadius * 3)
            elseif visionShape == "Triangle" then
                local mesh = Instance.new("SpecialMesh")
                mesh.MeshType = Enum.MeshType.Wedge
                mesh.Scale = Vector3.new(calcRadius * 2, 0.1, calcRadius * 2)
                mesh.Parent = shapePart
                shapePart.Size = Vector3.new(calcRadius * 2, 0.1, calcRadius * 2)
            end

            local weld = Instance.new("Weld")
            weld.Part0 = hrp
            weld.Part1 = shapePart
            weld.C0 = CFrame.new(0, -(hrp.Size.Y / 2), 0)
            weld.Parent = shapePart

            shapePart.Parent = hrp
            activeCones[killer] = shapePart
        end
    end
end

local function updateHitbox(killer)
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if showHitboxOn then
        if not activeHitboxes[killer] then
            local box = Instance.new("SelectionBox")
            box.Name = "HitboxVisual"
            box.Color3 = Color3.fromRGB(255, 0, 0)
            box.LineThickness = 0.05
            box.Adornee = hrp
            box.Parent = hrp
            activeHitboxes[killer] = box
        end
    elseif activeHitboxes[killer] then
        activeHitboxes[killer]:Destroy()
        activeHitboxes[killer] = nil
    end
end

-- Fallback Helper
local function AddElement(tab, elementType, config)
    local method = tab[elementType] or tab["Add" .. elementType]
    if type(method) == "function" then
        return method(tab, config)
    end
end

