    Min = 0.5,
    Max = 5.0,
    Step = 0.1,
    Value = { Min = 0.5, Max = 5.0, Default = backDistance },
    Callback = function(val)
        backDistance = typeof(val) == "table" and (val.Default or val.Value or 2.2) or val
    end
})

